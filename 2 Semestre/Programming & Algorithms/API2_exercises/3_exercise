# Definição da função
def encontrar_maior(a, b, c):
    if a >= b and a >= c:
        return a
    elif b >= a and b >= c:
        return b
    else:
        return c

# Código principal
n1 = int(input("Digite o primeiro número inteiro: "))
n2 = int(input("Digite o segundo número inteiro: "))
n3 = int(input("Digite o terceiro número inteiro: "))

maior_valor = encontrar_maior(n1, n2, n3)
print(f"O maior valor digitado é: {maior_valor}")
